{
	"compilerOptions": {
		"target": "es2020",
		"module": "commonjs",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"moduleResolution": "node",
		"types": ["node"],
		"lib": ["es2020"]
	},
	"include": [
		"src/**/*"
	],
	"exclude": ["node_modules"]
}
