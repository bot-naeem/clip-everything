{
	"name": "clip-everything",
	"version": "2.0.0",
	"description": "Clip web pages to Markdown notes with a real browser (Playwright + Defuddle).",
	"license": "MIT",
	"author": "wmm",
	"keywords": [
		"markdown",
		"web-clipper",
		"clip",
		"obsidian",
		"playwright",
		"defuddle",
		"readability"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bot-naeem/clip-everything.git"
	},
	"bugs": {
		"url": "https://github.com/bot-naeem/clip-everything/issues"
	},
	"homepage": "https://github.com/bot-naeem/clip-everything#readme",
	"bin": {
		"clip-everything": "scripts/clip.js"
	},
	"files": [
		"scripts/",
		"src/",
		"README.md",
		"README.zh-CN.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"clip": "node scripts/clip.js",
		"clip:acceptance": "node scripts/acceptance.js",
		"clip:zhihu-acceptance": "bash scripts/zhihu-acceptance.sh",
		"install-browser": "npx --yes playwright@latest install chromium",
		"prepublishOnly": "npm test",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^22.5.4",
		"@types/turndown": "^5.0.5",
		"vitest": "^2.1.9"
	},
	"dependencies": {
		"defuddle": "^0.19.6",
		"jsdom": "^26.0.0",
		"mathml-to-latex": "^1.4.1",
		"playwright-core": "^1.64.1",
		"ts-node": "^10.9.2",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^5.5.4"
	}
}
